      <Button layoutX="431.0" layoutY="138.0" mnemonicParsing="false" onAction="#handleLiveSpeed" text="Toggle Live Speed" />
      <Button layoutX="173.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleReadFuelLevel" text="Fuel Level" />
      <Button layoutX="31.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleReadCoolant" text="Read Coolant Temp" />
