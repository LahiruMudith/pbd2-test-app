            <Font size="14.0" />
         </font></TextArea>
      <Label fx:id="lblSpeed" alignment="CENTER" layoutX="397.0" layoutY="206.0" prefHeight="43.0" prefWidth="181.0" text="0" textAlignment="CENTER" textFill="#e10000">
